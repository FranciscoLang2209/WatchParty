# URL del proyecto Supabase (local o remoto)
SUPABASE_URL=

# Clave anónima (pública) de Supabase — nunca la service_role
SUPABASE_ANON_KEY=

# Origen exacto del frontend (Vite) permitido por CORS
WEB_ORIGIN=

# Base URL de la cuenta directa de API-Football. Sin slash final.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Clave privada de API-Football. Definir sólo en el entorno del backend.
API_FOOTBALL_KEY=