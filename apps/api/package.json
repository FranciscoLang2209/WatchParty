{
  "name": "@watchparty/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:auth-matches": "tsx --env-file-if-exists=.env scripts/smoke-auth-matches.ts",
    "verify:sports-data": "tsx --env-file-if-exists=.env scripts/verify-sports-data-schema.ts",
    "verify:profiles": "tsx --env-file-if-exists=.env scripts/verify-profiles-schema.ts",
    "verify:comments": "tsx --env-file-if-exists=.env scripts/verify-comments-schema.ts",
    "verify:match-search": "tsx --env-file-if-exists=.env scripts/verify-match-search.ts",
    "verify:watched-matches": "tsx --env-file-if-exists=.env scripts/verify-watched-matches-schema.ts",
    "verify:match-ratings": "tsx --env-file-if-exists=.env scripts/verify-match-ratings-schema.ts",
    "verify:match-rating-api": "tsx --env-file-if-exists=.env scripts/verify-match-rating-api.ts",
    "verify:rated-match-rate": "tsx --env-file-if-exists=.env scripts/verify-rated-match-rate.ts",
    "verify:monthly-interactions-avg": "tsx --env-file-if-exists=.env scripts/verify-monthly-interactions-avg.ts",
    "verify:watched-history-journey": "tsx --env-file-if-exists=.env scripts/verify-watched-history-journey.ts",
    "matches:sync": "tsx --env-file-if-exists=.env src/scripts/sync-matches.ts",
    "reporter:collect": "tsx --env-file-if-exists=.env src/scripts/collect-kpis.ts",
    "reporter:publish": "tsx --env-file-if-exists=.env src/scripts/publish-kpis.ts",
    "reporter:verify-business": "tsx --env-file-if-exists=.env src/scripts/verify-business-aggregates.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
